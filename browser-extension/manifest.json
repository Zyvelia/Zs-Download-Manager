{
  "manifest_version": 3,
  "name": "Send to Z's Download Manager",
  "version": "1.0.0",
  "description": "Send selected links to your local download manager for confirmation.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send a link to Z's",
    "default_popup": "popup.html"
  }
}
